# Required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key-here

# Optional — if set, the workspace requires this string before generation.
# Share it out-of-band with people you want to use the deployment.
ACCESS_PASSCODE=

# Optional — per-IP generations allowed per rolling hour. Defaults to 20.
RATE_LIMIT_PER_HOUR=20
