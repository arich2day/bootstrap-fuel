# Required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key-here

# Optional pre-launch gate. If set, the workspace requires this passcode.
# Leave empty for a public Free + Pro deployment.
ACCESS_PASSCODE=

# Free / Pro tier rate limits (generations per rolling hour, per identity)
FREE_RATE_LIMIT_PER_HOUR=3
PRO_RATE_LIMIT_PER_HOUR=100

# LemonSqueezy license validation. Leave PRO_CHECKOUT_URL empty to hide the
# Upgrade button. STORE_ID is optional but recommended (rejects keys from
# other stores).
PRO_CHECKOUT_URL=
LEMONSQUEEZY_STORE_ID=
